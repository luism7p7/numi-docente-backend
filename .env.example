# Copia este archivo como .env y completa tus datos. El .env NO se sube a git.
# En el servidor estos valores los pone docker compose (ver numi-admin-backend/despliegue/compose.yaml).

# ---- MySQL (la misma base que crea numi-admin-backend) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=numi

# Clave para firmar la cookie de sesión. Genérala con:  python -c "import secrets; print(secrets.token_hex(32))"
DOCENTE_SECRET_KEY=

# 1 = la cookie de sesión solo viaja por HTTPS (en el servidor)
SESSION_COOKIE_SECURE=0

# Backend de la app Numi: de aquí sale la versión del paquete de conocimiento
APP_API_URL=https://app-educativa-medellin-production-854b.up.railway.app
# Clave que envía el backend de la app en la cabecera X-Api-Key para usar /api/app/v1/... (vacía = puente apagado)
APP_API_KEY=

# Carpeta con los archivos que sube el panel administrativo (en local: la de numi-admin-backend)
UPLOADS_DIR=../numi-admin-backend/uploads
